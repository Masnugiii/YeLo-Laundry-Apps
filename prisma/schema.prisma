  employee      Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contributions IroningContribution[]

  @@index([orderId], map: "idx_ironing_jobs_order_id")
  @@index([employeeId], map: "idx_ironing_jobs_employee_id")
  @@index([status], map: "idx_ironing_jobs_status")
  @@index([priority], map: "idx_ironing_jobs_priority")
  @@index([acceptedAt], map: "idx_ironing_jobs_accepted_at")
  @@index([finishedAt], map: "idx_ironing_jobs_finished_at")
  @@index([deletedAt], map: "idx_ironing_jobs_deleted_at")
