// ---------------------------------------------------------------------------
// Enums — Orders
// ---------------------------------------------------------------------------

/// Order-level payment settlement status.
enum OrderPaymentStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED

  @@map("order_payment_status")
}

/// Order fulfillment lifecycle status.
enum OrderStatus {
  CREATED
  WAITING_PAYMENT
  PAYMENT_CONFIRMED
  WAITING_BINATU
  IRONING_ACCEPTED
  CURRENTLY_IRONING
  FINISHED_IRONING
  READY_FOR_PICKUP
  WAITING_PICKUP_DRIVER
  PICKUP_COMPLETED
  WAITING_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

/// Category of photo attached to an order.
enum PhotoType {
  CUSTOMER_ITEM
  BEFORE_WASH
  AFTER_WASH
  AFTER_IRONING
  DELIVERY_PROOF
  RECEIPT
  OTHER

  @@map("photo_type")
}

/// Category of activity entry in the order timeline.
enum TimelineType {
  ORDER
  PAYMENT
  IRONING
  PICKUP
  DELIVERY
  NOTIFICATION
  CUSTOMER_SERVICE
  SYSTEM

  @@map("timeline_type")
}

/// Payment method snapshot on order header (denormalized).
enum OrderPaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
  YELO_WALLET

  @@map("order_payment_method")
}

// ---------------------------------------------------------------------------
// Order
// ---------------------------------------------------------------------------

/// Laundry order header — one transaction per customer visit.
model Order {
  id                  String              @id @default(uuid()) @db.Uuid
  queueNumber         String              @map("queue_number") @db.VarChar(20)
  invoiceNumber       String              @unique @map("invoice_number") @db.VarChar(30)
  customerId          String              @map("customer_id") @db.Uuid
  orderDate           DateTime            @default(now()) @map("order_date") @db.Timestamptz(6)
  receivedDate        DateTime?           @map("received_date") @db.Timestamptz(6)
  estimatedFinishDate DateTime?           @map("estimated_finish_date") @db.Timestamptz(6)
  completedDate       DateTime?           @map("completed_date") @db.Timestamptz(6)
  pickupRequired      Boolean             @default(false) @map("pickup_required")
  deliveryRequired    Boolean             @default(false) @map("delivery_required")
  pickupAddressId     String?             @map("pickup_address_id") @db.Uuid
  deliveryAddressId   String?             @map("delivery_address_id") @db.Uuid
  paymentStatus       OrderPaymentStatus  @default(UNPAID) @map("payment_status")
  orderStatus         OrderStatus         @default(CREATED) @map("order_status")
  paymentMethod       OrderPaymentMethod? @map("payment_method")
  notes               String?             @db.Text
  createdByEmployeeId String              @map("created_by_employee_id") @db.Uuid
  updatedByEmployeeId String?             @map("updated_by_employee_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pickupAddress     CustomerAddress?     @relation("OrderPickupAddress", fields: [pickupAddressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryAddress   CustomerAddress?     @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdByEmployee Employee             @relation("OrderCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedByEmployee Employee?            @relation("OrderUpdatedBy", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items             OrderItem[]
  statusHistories   OrderStatusHistory[]
  photos            OrderPhoto[]
  timelines         OrderTimeline[]
  payments          Payment[]
  ironingJobs       IroningJob[]
  pickupJob         PickupJob?
  deliveryJob       DeliveryJob?
  driverActivities  DriverActivity[]

  @@index([customerId], map: "idx_orders_customer_id")
  @@index([queueNumber], map: "idx_orders_queue_number")
  @@index([orderStatus], map: "idx_orders_order_status")
  @@index([paymentStatus], map: "idx_orders_payment_status")
  @@index([orderStatus, deletedAt], map: "idx_orders_status_active")
  @@index([paymentStatus, deletedAt], map: "idx_orders_payment_active")
  @@index([receivedDate], map: "idx_orders_received_date")
  @@index([estimatedFinishDate], map: "idx_orders_estimated_finish_date")
  @@index([orderDate], map: "idx_orders_order_date")
  @@index([createdByEmployeeId], map: "idx_orders_created_by_employee_id")
  @@index([updatedByEmployeeId], map: "idx_orders_updated_by_employee_id")
  @@index([deletedAt], map: "idx_orders_deleted_at")
  @@map("orders")
}

// ---------------------------------------------------------------------------
// OrderItem
// ---------------------------------------------------------------------------

/// Line item within an order — stores price snapshot at transaction time.
model OrderItem {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  serviceId      String    @map("service_id") @db.Uuid
  servicePriceId String    @map("service_price_id") @db.Uuid
  quantity       Decimal   @db.Decimal(10, 3)
  weight         Decimal?  @db.Decimal(10, 3)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(15, 2)
  subtotal       Decimal   @db.Decimal(15, 2)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  servicePrice ServicePrice @relation(fields: [servicePriceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([serviceId], map: "idx_order_items_service_id")
  @@index([servicePriceId], map: "idx_order_items_service_price_id")
  @@index([deletedAt], map: "idx_order_items_deleted_at")
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// OrderStatusHistory
// ---------------------------------------------------------------------------

/// Audit trail of every order status transition.
model OrderStatusHistory {
  id                  String       @id @default(uuid()) @db.Uuid
  orderId             String       @map("order_id") @db.Uuid
  previousStatus      OrderStatus? @map("previous_status")
  currentStatus       OrderStatus  @map("current_status")
  changedByEmployeeId String?      @map("changed_by_employee_id") @db.Uuid
  notes               String?      @db.Text
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedByEmployee Employee? @relation(fields: [changedByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId], map: "idx_order_status_histories_order_id")
  @@index([currentStatus], map: "idx_order_status_histories_current_status")
  @@index([changedByEmployeeId], map: "idx_order_status_histories_changed_by")
  @@index([createdAt], map: "idx_order_status_histories_created_at")
  @@map("order_status_histories")
}

// ---------------------------------------------------------------------------
// OrderPhoto
// ---------------------------------------------------------------------------

/// Photos attached to an order (items, process proof, delivery proof, etc.).
model OrderPhoto {
  id                   String    @id @default(uuid()) @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  photoType            PhotoType @map("photo_type")
  photoUrl             String    @map("photo_url") @db.VarChar(500)
  uploadedByEmployeeId String    @map("uploaded_by_employee_id") @db.Uuid
  description          String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedByEmployee Employee @relation(fields: [uploadedByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId], map: "idx_order_photos_order_id")
  @@index([photoType], map: "idx_order_photos_photo_type")
  @@index([uploadedByEmployeeId], map: "idx_order_photos_uploaded_by")
  @@index([createdAt], map: "idx_order_photos_created_at")
  @@map("order_photos")
}

// ---------------------------------------------------------------------------
// OrderTimeline
// ---------------------------------------------------------------------------

/// Single source of truth for all order activity shown across dashboards and apps.
model OrderTimeline {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  timelineType TimelineType @map("timeline_type")
  title        String       @db.VarChar(200)
  description  String?      @db.Text
  employeeId   String?      @map("employee_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId], map: "idx_order_timelines_order_id")
  @@index([timelineType], map: "idx_order_timelines_timeline_type")
  @@index([employeeId], map: "idx_order_timelines_employee_id")
  @@index([createdAt], map: "idx_order_timelines_created_at")
  @@map("order_timelines")
}

// ===========================================================================
// Finance Module
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums — Finance
// ---------------------------------------------------------------------------

/// Individual payment transaction status.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED

  @@map("payment_transaction_status")
}

/// Cashflow ledger entry direction.
enum CashflowType {
  INCOME
  EXPENSE

  @@map("cashflow_type")
}

/// Polymorphic source type for cashflow ledger entries.
enum ReferenceType {
  ORDER_PAYMENT
  WALLET_TOPUP
  REFUND
  EXPENSE
  PAYROLL
  SYSTEM

  @@map("reference_type")
}

// ---------------------------------------------------------------------------
// PaymentMethod
// ---------------------------------------------------------------------------

/// Master data for payment methods (CASH, QRIS, BANK_TRANSFER, YELO_WALLET).
model PaymentMethod {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(30)
  name      String    @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  payments Payment[]

  @@index([isActive], map: "idx_payment_methods_is_active")
  @@index([deletedAt], map: "idx_payment_methods_deleted_at")
  @@map("payment_methods")
}

// ---------------------------------------------------------------------------
// Payment
// ---------------------------------------------------------------------------

/// Payment transaction linked to an order.
model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  paymentMethodId      String        @map("payment_method_id") @db.Uuid
  amount               Decimal       @db.Decimal(15, 2)
  paidAt               DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  referenceNumber      String?       @unique @map("reference_number") @db.VarChar(50)
  paymentStatus        PaymentStatus @default(PENDING) @map("payment_status")
  receivedByEmployeeId String        @map("received_by_employee_id") @db.Uuid
  notes                String?       @db.Text
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)

  // Relations
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentMethod      PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receivedByEmployee Employee      @relation("PaymentReceivedBy", fields: [receivedByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId], map: "idx_payments_order_id")
  @@index([paymentMethodId], map: "idx_payments_payment_method_id")
  @@index([paymentStatus], map: "idx_payments_payment_status")
  @@index([paidAt], map: "idx_payments_paid_at")
  @@index([receivedByEmployeeId], map: "idx_payments_received_by_employee_id")
  @@index([deletedAt], map: "idx_payments_deleted_at")
  @@map("payments")
}

// ---------------------------------------------------------------------------
// ExpenseCategory
// ---------------------------------------------------------------------------

/// Master data for operational expense categories.
model ExpenseCategory {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  expenses Expense[]

  @@index([isActive], map: "idx_expense_categories_is_active")
  @@index([deletedAt], map: "idx_expense_categories_deleted_at")
  @@map("expense_categories")
}

// ---------------------------------------------------------------------------
// Expense
// ---------------------------------------------------------------------------

/// Operational business expense record.
model Expense {
  id                String    @id @default(uuid()) @db.Uuid
  expenseCategoryId String    @map("expense_category_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  title             String    @db.VarChar(200)
  description       String?   @db.Text
  amount            Decimal   @db.Decimal(15, 2)
  expenseDate       DateTime  @map("expense_date") @db.Date
  receiptPhotoUrl   String?   @map("receipt_photo_url") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([expenseCategoryId], map: "idx_expenses_expense_category_id")
  @@index([employeeId], map: "idx_expenses_employee_id")
  @@index([expenseDate], map: "idx_expenses_expense_date")
  @@index([deletedAt], map: "idx_expenses_deleted_at")
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Cashflow
// ---------------------------------------------------------------------------

/// Financial ledger — single source of truth for all money movements.
model Cashflow {
  id                  String        @id @default(uuid()) @db.Uuid
  type                CashflowType  @map("type")
  referenceType       ReferenceType @map("reference_type")
  referenceId         String        @map("reference_id") @db.Uuid
  amount              Decimal       @db.Decimal(15, 2)
  transactionDate     DateTime      @map("transaction_date") @db.Timestamptz(6)
  description         String?       @db.Text
  createdByEmployeeId String        @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  createdByEmployee Employee @relation(fields: [createdByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([type], map: "idx_cashflows_type")
  @@index([referenceType, referenceId], map: "idx_cashflows_reference")
  @@index([transactionDate], map: "idx_cashflows_transaction_date")
  @@index([createdByEmployeeId], map: "idx_cashflows_created_by_employee_id")
  @@map("cashflows")
}

// ===========================================================================
// Operations Module
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums — Operations
// ---------------------------------------------------------------------------

/// Daily attendance outcome for an employee.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  SICK

  @@map("attendance_status")
}

/// Clock activity type recorded in attendance logs.
enum AttendanceActivityType {
  CHECK_IN
  CHECK_OUT

  @@map("attendance_activity_type")
}

/// Ironing job lifecycle status for Binatu monitoring.
enum IroningStatus {
  WAITING
  ACCEPTED
  IN_PROGRESS
  FINISHED
  CANCELLED

  @@map("ironing_status")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

/// Daily employee attendance record — one per employee per day.
model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkIn        DateTime?        @map("check_in") @db.Timestamptz(6)
  checkOut       DateTime?        @map("check_out") @db.Timestamptz(6)
  workingMinutes Int?             @map("working_minutes")
  lateMinutes    Int              @default(0) @map("late_minutes")
  status         AttendanceStatus @default(PRESENT)
  notes          String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  logs     AttendanceLog[]

  @@unique([employeeId, attendanceDate], map: "idx_attendances_employee_date")
  @@index([employeeId], map: "idx_attendances_employee_id")
  @@index([attendanceDate], map: "idx_attendances_attendance_date")
  @@index([status], map: "idx_attendances_status")
  @@index([deletedAt], map: "idx_attendances_deleted_at")
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// AttendanceLog
// ---------------------------------------------------------------------------

/// Audit trail of every check-in/check-out activity.
model AttendanceLog {
  id           String                 @id @default(uuid()) @db.Uuid
  attendanceId String                 @map("attendance_id") @db.Uuid
  employeeId   String                 @map("employee_id") @db.Uuid
  activityType AttendanceActivityType @map("activity_type")
  activityTime DateTime               @map("activity_time") @db.Timestamptz(6)
  latitude     Decimal?               @db.Decimal(10, 7)
  longitude    Decimal?               @db.Decimal(10, 7)
  deviceInfo   String?                @map("device_info") @db.VarChar(255)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([attendanceId], map: "idx_attendance_logs_attendance_id")
  @@index([employeeId], map: "idx_attendance_logs_employee_id")
  @@index([activityType], map: "idx_attendance_logs_activity_type")
  @@index([activityTime], map: "idx_attendance_logs_activity_time")
  @@map("attendance_logs")
}

// ---------------------------------------------------------------------------
// AttendanceSetting
// ---------------------------------------------------------------------------

/// Attendance configuration (work hours, late tolerance, overtime rules).
model AttendanceSetting {
  id                   String   @id @default(uuid()) @db.Uuid
  workStartTime        DateTime @map("work_start_time") @db.Time(0)
  workEndTime          DateTime @map("work_end_time") @db.Time(0)
  lateToleranceMinutes Int      @default(0) @map("late_tolerance_minutes")
  overtimeEnabled      Boolean  @default(false) @map("overtime_enabled")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_attendance_settings_is_active")
  @@map("attendance_settings")
}

// ---------------------------------------------------------------------------
// IroningJob
// ---------------------------------------------------------------------------

/// Ironing assignment for Binatu — linked to an order for KPI tracking.
model IroningJob {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  employeeId       String?       @map("employee_id") @db.Uuid
  acceptedAt       DateTime?     @map("accepted_at") @db.Timestamptz(6)
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?     @map("finished_at") @db.Timestamptz(6)
  status           IroningStatus @default(WAITING)
  priority         PriorityLevel @default(NORMAL)
  estimatedMinutes Int?          @map("estimated_minutes")
