// Yelo Laundry ERP — Production PostgreSQL Schema
// Reference: docs/02_ERD.md, docs/03_DATA_DICTIONARY.md, docs/04_BUSINESS_RULES.md, docs/06_BACKEND_ARCHITECTURE.md
// Conventions: UUID PK (@default(uuid())), Decimal(15,2) for money, Timestamptz(6) for datetimes, soft delete via deletedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Employment and login account status.
/// Aligns with users.status (active, inactive, suspended) and employees.status (resigned).
enum EmployeeStatus {
  active
  inactive
  suspended
  resigned

  @@map("employee_status")
}

/// System role codes.
/// Display names: Owner, Kasir, Operator, Manajer, Binatu, Driver.
enum RoleCode {
  owner
  cashier
  cashier_laundry
  cashier_laundry_driver
  laundry
  driver

  @@map("role_code")
}

/// OTP request purpose.
enum OtpPurpose {
  login
  register
  password_reset

  @@map("otp_purpose")
}

/// OTP verification lifecycle status.
enum OtpStatus {
  pending
  verified
  expired
  failed

  @@map("otp_status")
}

// ---------------------------------------------------------------------------
// Employee
// ---------------------------------------------------------------------------

/// Consolidated employee identity and login account.
/// Merges `users` auth fields with `employees` master data per auth module scope.
model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  employeeCode String         @unique @map("employee_code") @db.VarChar(20)
  fullName     String         @map("full_name") @db.VarChar(150)
  phone        String         @unique @db.VarChar(20)
  email        String?        @unique @db.VarChar(150)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  photoUrl     String?        @map("photo_url") @db.VarChar(500)
  position     String         @db.VarChar(100)
  status       EmployeeStatus @default(active)
  hiredAt      DateTime?      @map("hired_at") @db.Date
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employeeRoles           EmployeeRole[]           @relation("EmployeeRoles")
  assignedRoles           EmployeeRole[]           @relation("RoleAssignedBy")
  sessions                EmployeeSession[]
  otpCodes                OtpCode[]
  walletTransactions      WalletTransaction[]
  rewardPoints            RewardPoint[]
  customerNotes           CustomerNote[]
  createdOrders           Order[]                  @relation("OrderCreatedBy")
  updatedOrders           Order[]                  @relation("OrderUpdatedBy")
  orderStatusChanges      OrderStatusHistory[]
  orderPhotos             OrderPhoto[]
  orderTimelines          OrderTimeline[]
  receivedPayments        Payment[]                @relation("PaymentReceivedBy")
  expenses                Expense[]
  cashflows               Cashflow[]
  attendances             Attendance[]
  attendanceLogs          AttendanceLog[]
  ironingJobs             IroningJob[]
  ironingContributions    IroningContribution[]
  pickupJobs              PickupJob[]              @relation("PickupJobDriver")
  deliveryJobs            DeliveryJob[]            @relation("DeliveryJobDriver")
  driverActivities        DriverActivity[]         @relation("DriverActivityDriver")
  sentNotifications       Notification[]           @relation("NotificationSender")
  notificationReads       NotificationRead[]
  assignedCsTickets       CustomerServiceTicket[]  @relation("CsTicketAssignee")
  customerServiceMessages CustomerServiceMessage[]
  auditLogs               AuditLog[]
  uploadedMediaFiles      MediaFile[]
  payrollRecords          PayrollRecord[]
  payrollApprovalEvents   PayrollApprovalEvent[] @relation("PayrollApprovalActor")
  payrollPayments         PayrollPayment[]       @relation("PayrollPaymentActor")

  @@index([status], map: "idx_employees_status")
  @@index([deletedAt], map: "idx_employees_deleted_at")
  @@index([fullName], map: "idx_employees_full_name")
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Role
// ---------------------------------------------------------------------------

/// Defines system roles for RBAC.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        RoleCode  @unique
  name        String    @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employeeRoles   EmployeeRole[]
  rolePermissions RolePermission[]

  @@index([isActive], map: "idx_roles_is_active")
  @@index([deletedAt], map: "idx_roles_deleted_at")
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Permission
// ---------------------------------------------------------------------------

/// Granular permission definitions for RBAC.
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(150)
  module      String    @db.VarChar(50)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  rolePermissions RolePermission[]

  @@index([module], map: "idx_permissions_module")
  @@index([isActive], map: "idx_permissions_is_active")
  @@index([deletedAt], map: "idx_permissions_deleted_at")
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// EmployeeRole (junction: Employee ↔ Role)
// ---------------------------------------------------------------------------

/// Assigns one or more roles to an employee.
/// Equivalent to `user_roles` in ERD, scoped to Employee.
model EmployeeRole {
  id                   String    @id @default(uuid()) @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  roleId               String    @map("role_id") @db.Uuid
  assignedAt           DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByEmployeeId String?   @map("assigned_by_employee_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employee   Employee  @relation("EmployeeRoles", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy Employee? @relation("RoleAssignedBy", fields: [assignedByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([employeeId, roleId], map: "idx_employee_roles_unique")
  @@index([employeeId], map: "idx_employee_roles_employee_id")
  @@index([roleId], map: "idx_employee_roles_role_id")
  @@index([assignedByEmployeeId], map: "idx_employee_roles_assigned_by")
  @@index([deletedAt], map: "idx_employee_roles_deleted_at")
  @@map("employee_roles")
}

// ---------------------------------------------------------------------------
// RolePermission (junction: Role ↔ Permission)
// ---------------------------------------------------------------------------

/// Maps permissions to roles.
model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId], map: "idx_role_permissions_unique")
  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@index([deletedAt], map: "idx_role_permissions_deleted_at")
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// EmployeeSession
// ---------------------------------------------------------------------------

/// Active login sessions and refresh tokens.
/// Equivalent to `user_sessions` in ERD, scoped to Employee.
model EmployeeSession {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  deviceInfo       String?   @map("device_info") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([employeeId], map: "idx_employee_sessions_employee_id")
  @@index([expiresAt], map: "idx_employee_sessions_expires_at")
  @@index([deletedAt], map: "idx_employee_sessions_deleted_at")
  @@map("employee_sessions")
}

// ---------------------------------------------------------------------------
// OtpCode
// ---------------------------------------------------------------------------

/// OTP verification records for passwordless login via WhatsApp.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  employeeId  String?    @map("employee_id") @db.Uuid
  phone       String     @db.VarChar(20)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  purpose     OtpPurpose
  status      OtpStatus  @default(pending)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  // Relations
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([phone], map: "idx_otp_codes_phone")
  @@index([status], map: "idx_otp_codes_status")
  @@index([expiresAt], map: "idx_otp_codes_expires_at")
  @@index([employeeId], map: "idx_otp_codes_employee_id")
  @@index([deletedAt], map: "idx_otp_codes_deleted_at")
  @@map("otp_codes")
}

// ===========================================================================
// Customer Module
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums — Customer
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
  other

  @@map("gender")
}

enum WalletTransactionType {
  top_up
  deduction
  refund
  adjustment
  promotion
  manual_credit
  manual_debit

  @@map("wallet_transaction_type")
}

enum RewardPointType {
  earn
  redeem
  expired

  @@map("reward_point_type")
}

enum RewardPointSource {
  laundry_payment
  promotion
  birthday
  referral
  manual_bonus
  redeem
  voucher
  wallet_credit

  @@map("reward_point_source")
}

enum LoyaltyVoucherDiscountType {
  PERCENTAGE
  FIXED

  @@map("loyalty_voucher_discount_type")
}

enum LoyaltyVoucherStatus {
  ACTIVE
  INACTIVE
  EXPIRED

  @@map("loyalty_voucher_status")
}

enum CashbackType {
  PERCENTAGE
  FIXED

  @@map("cashback_type")
}

enum DevicePlatform {
  android
  ios

  @@map("device_platform")
}

/// Shared urgency/priority level used across ironing, notifications, and tickets.
enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("priority_level")
}

// ---------------------------------------------------------------------------
// Customer
// ---------------------------------------------------------------------------

/// Core customer profile for laundry service.
model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  customerCode     String    @unique @map("customer_code") @db.VarChar(20)
  fullName         String    @map("full_name") @db.VarChar(150)
  phone            String    @unique @db.VarChar(20)
  email            String?   @db.VarChar(150)
  gender           Gender?
  birthDate        DateTime? @map("birth_date") @db.Date
  defaultAddressId String?   @unique @map("default_address_id") @db.Uuid
  photoUrl         String?   @map("photo_url") @db.VarChar(500)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  defaultAddress          CustomerAddress?         @relation("CustomerDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  addresses               CustomerAddress[]        @relation("CustomerAddresses")
  wallet                  CustomerWallet?
  walletTransactions      WalletTransaction[]
  rewardPoints            RewardPoint[]
  notes                   CustomerNote[]
  devices                 CustomerDevice[]
  orders                  Order[]
  customerServiceTickets  CustomerServiceTicket[]
  customerServiceMessages CustomerServiceMessage[]

  @@index([fullName], map: "idx_customers_full_name")
  @@index([isActive], map: "idx_customers_is_active")
  @@index([deletedAt], map: "idx_customers_deleted_at")
  @@map("customers")
}

// ---------------------------------------------------------------------------
// CustomerAddress
// ---------------------------------------------------------------------------

/// Multiple delivery/pickup addresses per customer.
model CustomerAddress {
  id            String    @id @default(uuid()) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(150)
  phone         String    @db.VarChar(20)
  province      String    @db.VarChar(100)
  city          String    @db.VarChar(100)
  district      String    @db.VarChar(100)
  postalCode    String?   @map("postal_code") @db.VarChar(10)
  addressDetail String    @map("address_detail") @db.Text
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer           Customer      @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  defaultForCustomer Customer?     @relation("CustomerDefaultAddress")
  pickupOrders       Order[]       @relation("OrderPickupAddress")
  deliveryOrders     Order[]       @relation("OrderDeliveryAddress")
  pickupJobs         PickupJob[]   @relation("PickupJobAddress")
  deliveryJobs       DeliveryJob[] @relation("DeliveryJobAddress")

  @@index([customerId], map: "idx_customer_addresses_customer_id")
  @@index([isDefault], map: "idx_customer_addresses_is_default")
  @@index([deletedAt], map: "idx_customer_addresses_deleted_at")
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// CustomerWallet
// ---------------------------------------------------------------------------

/// One prepaid wallet per customer.
model CustomerWallet {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String    @unique @map("customer_id") @db.Uuid
  currentBalance   Decimal   @default(0) @map("current_balance") @db.Decimal(15, 2)
  currency         String    @default("IDR") @db.VarChar(3)
  balanceUpdatedAt DateTime  @default(now()) @map("balance_updated_at") @db.Timestamptz(6)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions WalletTransaction[]

  @@index([deletedAt], map: "idx_customer_wallets_deleted_at")
  @@map("customer_wallets")
}

// ---------------------------------------------------------------------------
// WalletTransaction
// ---------------------------------------------------------------------------

/// Wallet credit and debit transaction history.
model WalletTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  customerId            String                @map("customer_id") @db.Uuid
  walletId              String                @map("wallet_id") @db.Uuid
  referenceNumber       String?               @unique @map("reference_number") @db.VarChar(50)
  amount                Decimal               @db.Decimal(15, 2)
  balanceAfter          Decimal?              @map("balance_after") @db.Decimal(15, 2)
  type                  WalletTransactionType
  description           String?               @db.Text
  referenceType         String?               @map("reference_type") @db.VarChar(50)
  referenceId           String?               @map("reference_id") @db.Uuid
  reversedTransactionId String?               @unique @map("reversed_transaction_id") @db.Uuid
  createdByEmployeeId   String?               @map("created_by_employee_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  wallet                CustomerWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByEmployee     Employee?         @relation(fields: [createdByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reversedTransaction   WalletTransaction? @relation("WalletTransactionReversal", fields: [reversedTransactionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reversalOf            WalletTransaction? @relation("WalletTransactionReversal")

  @@index([customerId], map: "idx_wallet_transactions_customer_id")
  @@index([walletId], map: "idx_wallet_transactions_wallet_id")
  @@index([type], map: "idx_wallet_transactions_type")
  @@index([createdAt], map: "idx_wallet_transactions_created_at")
  @@index([createdByEmployeeId], map: "idx_wallet_transactions_created_by")
  @@index([referenceId], map: "idx_wallet_transactions_reference_id")
  @@index([deletedAt], map: "idx_wallet_transactions_deleted_at")
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// RewardPoint
// ---------------------------------------------------------------------------

/// Customer loyalty reward point ledger.
model RewardPoint {
  id                  String             @id @default(uuid()) @db.Uuid
  customerId          String             @map("customer_id") @db.Uuid
  point               Int
  type                RewardPointType
  source              RewardPointSource?
  description         String?            @db.Text
  referenceType       String?            @map("reference_type") @db.VarChar(50)
  referenceId         String?            @map("reference_id") @db.Uuid
  balanceAfter        Int?               @map("balance_after")
  expiredAt           DateTime?          @map("expired_at") @db.Timestamptz(6)
  createdByEmployeeId String?            @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByEmployee Employee? @relation(fields: [createdByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([customerId], map: "idx_reward_points_customer_id")
  @@index([type], map: "idx_reward_points_type")
  @@index([source], map: "idx_reward_points_source")
  @@index([referenceId], map: "idx_reward_points_reference_id")
  @@index([expiredAt], map: "idx_reward_points_expired_at")
  @@index([deletedAt], map: "idx_reward_points_deleted_at")
  @@map("reward_points")
}

// ---------------------------------------------------------------------------
// LoyaltyVoucher
// ---------------------------------------------------------------------------

/// Customer loyalty voucher for discounts and promotions.
model LoyaltyVoucher {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                String                   @unique @db.VarChar(50)
  name                String                   @db.VarChar(150)
  discountType        LoyaltyVoucherDiscountType @map("discount_type")
  discountValue       Decimal                  @map("discount_value") @db.Decimal(15, 2)
  cashbackType        CashbackType?            @map("cashback_type")
  cashbackValue       Decimal?                 @map("cashback_value") @db.Decimal(15, 2)
  cashbackMax         Decimal?                 @map("cashback_max") @db.Decimal(15, 2)
  cashbackExpirationDays Int?                  @map("cashback_expiration_days")
  startDate           DateTime                 @map("start_date") @db.Timestamptz(6)
  endDate             DateTime                 @map("end_date") @db.Timestamptz(6)
  usageLimit          Int                      @default(0) @map("usage_limit")
  usageCount          Int                      @default(0) @map("usage_count")
  minimumTransaction  Decimal                  @default(0) @map("minimum_transaction") @db.Decimal(15, 2)
  status              LoyaltyVoucherStatus     @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)

  @@index([status], map: "idx_loyalty_vouchers_status")
  @@index([startDate, endDate], map: "idx_loyalty_vouchers_period")
  @@index([deletedAt], map: "idx_loyalty_vouchers_deleted_at")
  @@map("loyalty_vouchers")
}

// ---------------------------------------------------------------------------
// CustomerNote
// ---------------------------------------------------------------------------

/// Internal staff notes attached to a customer.
model CustomerNote {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  note       String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId], map: "idx_customer_notes_customer_id")
  @@index([employeeId], map: "idx_customer_notes_employee_id")
  @@index([createdAt], map: "idx_customer_notes_created_at")
  @@index([deletedAt], map: "idx_customer_notes_deleted_at")
  @@map("customer_notes")
}

// ---------------------------------------------------------------------------
// CustomerDevice
// ---------------------------------------------------------------------------

/// Push notification device registration for future Customer Mobile App.
model CustomerDevice {
  id          String         @id @default(uuid()) @db.Uuid
  customerId  String         @map("customer_id") @db.Uuid
  deviceToken String         @map("device_token") @db.VarChar(500)
  platform    DevicePlatform
  lastLoginAt DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([customerId, deviceToken], map: "idx_customer_devices_customer_token")
  @@index([platform], map: "idx_customer_devices_platform")
  @@index([deletedAt], map: "idx_customer_devices_deleted_at")
  @@map("customer_devices")
}

// ===========================================================================
// Laundry Services Module
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums — Laundry Services
// ---------------------------------------------------------------------------

/// Pricing unit type for laundry services.
enum ServiceUnitType {
  kg
  piece
  item

  @@map("service_unit_type")
}

// ---------------------------------------------------------------------------
