// ---------------------------------------------------------------------------
// CustomerServiceTicket
// ---------------------------------------------------------------------------

/// Customer service conversation ticket.
model CustomerServiceTicket {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  employeeId String?       @map("employee_id") @db.Uuid
  subject    String        @db.VarChar(200)
  status     TicketStatus  @default(OPEN)
  priority   PriorityLevel @default(NORMAL)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt   DateTime?     @map("closed_at") @db.Timestamptz(6)
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz(6)

  // Relations
  customer Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee Employee?                @relation("CsTicketAssignee", fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages CustomerServiceMessage[]

  @@index([customerId], map: "idx_customer_service_tickets_customer_id")
  @@index([employeeId], map: "idx_customer_service_tickets_employee_id")
  @@index([status], map: "idx_customer_service_tickets_status")
  @@index([priority], map: "idx_customer_service_tickets_priority")
  @@index([createdAt], map: "idx_customer_service_tickets_created_at")
  @@index([deletedAt], map: "idx_customer_service_tickets_deleted_at")
  @@map("customer_service_tickets")
}

// ---------------------------------------------------------------------------
// CustomerServiceMessage
// ---------------------------------------------------------------------------

/// Individual message within a customer service ticket.
model CustomerServiceMessage {
  id         String     @id @default(uuid()) @db.Uuid
  ticketId   String     @map("ticket_id") @db.Uuid
  senderType SenderType @map("sender_type")
  employeeId String?    @map("employee_id") @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid
  message    String     @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  ticket      CustomerServiceTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee    Employee?                   @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customer    Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments CustomerServiceAttachment[]

  @@index([ticketId], map: "idx_customer_service_messages_ticket_id")
  @@index([employeeId], map: "idx_customer_service_messages_employee_id")
  @@index([customerId], map: "idx_customer_service_messages_customer_id")
  @@index([senderType], map: "idx_customer_service_messages_sender_type")
  @@index([createdAt], map: "idx_customer_service_messages_created_at")
  @@map("customer_service_messages")
}

// ---------------------------------------------------------------------------
// CustomerServiceAttachment
// ---------------------------------------------------------------------------

/// File attachment on a customer service message.
model CustomerServiceAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(500)
