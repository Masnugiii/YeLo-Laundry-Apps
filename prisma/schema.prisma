  @@index([isActive], map: "idx_services_is_active")
  @@index([unitType], map: "idx_services_unit_type")
  @@index([deletedAt], map: "idx_services_deleted_at")
  @@map("services")
}

// ---------------------------------------------------------------------------
// ServicePrice
// ---------------------------------------------------------------------------

/// Price history per service with effective date ranges.
model ServicePrice {
  id            String    @id @default(uuid()) @db.Uuid
  serviceId     String    @map("service_id") @db.Uuid
  price         Decimal   @db.Decimal(15, 2)
  effectiveDate DateTime  @map("effective_date") @db.Date
  expiredDate   DateTime? @map("expired_date") @db.Date
