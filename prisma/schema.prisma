  // Relations
  message CustomerServiceMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([messageId], map: "idx_customer_service_attachments_message_id")
  @@index([createdAt], map: "idx_customer_service_attachments_created_at")
  @@map("customer_service_attachments")
}

