// ===========================================================================
// Payroll Module
// ===========================================================================

enum PayrollRecordStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID

  @@map("payroll_record_status")
}

enum PayrollBonusType {
  ATTENDANCE
  PERFORMANCE
  HOLIDAY
  MANUAL

  @@map("payroll_bonus_type")
}

enum PayrollDeductionType {
  ADVANCE
  PENALTY
  LOAN
  OTHER

  @@map("payroll_deduction_type")
}

enum PayrollPaymentMethod {
  CASH
  TRANSFER
  WALLET

  @@map("payroll_payment_method")
}

model PayrollRecord {
  id                     String              @id @default(uuid()) @db.Uuid
  payrollNumber          String              @unique @map("payroll_number") @db.VarChar(50)
  employeeId             String              @map("employee_id") @db.Uuid
  periodStart            DateTime            @map("period_start") @db.Date
  periodEnd              DateTime            @map("period_end") @db.Date
  role                   String              @db.VarChar(50)
  status                 PayrollRecordStatus @default(DRAFT)
  laundryKg              Decimal             @default(0) @map("laundry_kg") @db.Decimal(15, 2)
  laundryPiece           Decimal             @default(0) @map("laundry_piece") @db.Decimal(15, 2)
  ironingKg              Decimal             @default(0) @map("ironing_kg") @db.Decimal(15, 2)
  ironingPiece           Decimal             @default(0) @map("ironing_piece") @db.Decimal(15, 2)
  ordersFinished         Int                 @default(0) @map("orders_finished")
  productionSalary       Decimal             @default(0) @map("production_salary") @db.Decimal(15, 2)
  presentDays            Int                 @default(0) @map("present_days")
  absentDays             Int                 @default(0) @map("absent_days")
  lateDays               Int                 @default(0) @map("late_days")
  leaveDays              Int                 @default(0) @map("leave_days")
  baseSalary             Decimal             @default(0) @map("base_salary") @db.Decimal(15, 2)
  grossSalary            Decimal             @default(0) @map("gross_salary") @db.Decimal(15, 2)
  totalBonus             Decimal             @default(0) @map("total_bonus") @db.Decimal(15, 2)
  totalDeduction         Decimal             @default(0) @map("total_deduction") @db.Decimal(15, 2)
  netSalary              Decimal             @default(0) @map("net_salary") @db.Decimal(15, 2)
  calculatedAt           DateTime?           @map("calculated_at") @db.Timestamptz(6)
  calculatedByEmployeeId String?             @map("calculated_by_employee_id") @db.Uuid
  approvedAt             DateTime?           @map("approved_at") @db.Timestamptz(6)
  approvedByEmployeeId   String?             @map("approved_by_employee_id") @db.Uuid
  paidAt                 DateTime?           @map("paid_at") @db.Timestamptz(6)
  paidByEmployeeId       String?             @map("paid_by_employee_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)

  employee         Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bonuses          PayrollBonus[]
  deductions       PayrollDeduction[]
  approvalHistory  PayrollApprovalEvent[]
  payments         PayrollPayment[]

  @@index([employeeId], map: "idx_payroll_records_employee_id")
  @@index([periodStart, periodEnd], map: "idx_payroll_records_period")
  @@index([status], map: "idx_payroll_records_status")
  @@index([deletedAt], map: "idx_payroll_records_deleted_at")
  @@map("payroll_records")
}

model PayrollBonus {
  id              String           @id @default(uuid()) @db.Uuid
  payrollRecordId String           @map("payroll_record_id") @db.Uuid
  type            PayrollBonusType
  amount          Decimal          @db.Decimal(15, 2)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([payrollRecordId], map: "idx_payroll_bonuses_payroll_record_id")
  @@map("payroll_bonuses")
}

model PayrollDeduction {
  id              String               @id @default(uuid()) @db.Uuid
  payrollRecordId String               @map("payroll_record_id") @db.Uuid
  type            PayrollDeductionType
  amount          Decimal              @db.Decimal(15, 2)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([payrollRecordId], map: "idx_payroll_deductions_payroll_record_id")
  @@map("payroll_deductions")
}

