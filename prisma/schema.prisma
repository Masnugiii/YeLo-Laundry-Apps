  @@index([serviceId], map: "idx_service_prices_service_id")
  @@index([effectiveDate], map: "idx_service_prices_effective_date")
  @@index([expiredDate], map: "idx_service_prices_expired_date")
  @@index([isActive], map: "idx_service_prices_is_active")
  @@index([deletedAt], map: "idx_service_prices_deleted_at")
  @@map("service_prices")
}

// ===========================================================================
// Orders Module
