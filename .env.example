# ==================================================
# YeLo Laundry ERP — environment template
# Copy to .env locally. Never commit real secrets.
# Railway: set these in the service Variables tab.
# ==================================================

# --------------------------------------------------
# REQUIRED — NestJS will not start without these
# (this is the crash you see on Railway if they are empty)
# --------------------------------------------------

# PostgreSQL connection string from Railway Postgres (or your own host).
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Access-token signing secret (generate a long random string; do not reuse).
JWT_SECRET=

# Refresh-token signing secret (must be different from JWT_SECRET).
REFRESH_TOKEN_SECRET=

# --------------------------------------------------
# REQUIRED for production behavior
# --------------------------------------------------

# Use "production" on Railway so OTP plaintext is not logged.
APP_ENV=development

# Listen on all interfaces (required on Railway / containers).
APP_HOST=0.0.0.0

# Railway injects PORT automatically. Do not hard-code it in production.
# Local development uses APP_PORT instead.
# PORT=
APP_PORT=3000

# Comma-separated browser origins for Admin Web.
# Local default is used if unset. On Railway production include the Vercel Admin origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://ye-lo-laundry-apps.vercel.app

# --------------------------------------------------
# OPTIONAL — defaults exist in src/config/configuration.ts
# --------------------------------------------------

APP_NAME=Yelo Laundry ERP
API_PREFIX=api/v1
BODY_LIMIT=10mb
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Loaded into config but not used by NestJS services yet.
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated phones allowed for Admin Web dev OTP testing (local only).
# DEV_OTP_PHONE_WHITELIST=081234567890,081234567891,081910090910

# --------------------------------------------------
# Reserved / not read by NestJS src today
# Keep empty until the feature is wired. Do not treat as boot requirements.
# --------------------------------------------------

# OTP_LENGTH=6
# OTP_EXPIRED_MINUTES=5
# WHATSAPP_API_KEY=
# WHATSAPP_BASE_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# PAYMENT_PROVIDER=
# PAYMENT_MERCHANT_ID=
# PAYMENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_CALLBACK_URL=
# PAYMENT_RETURN_URL=

# --------------------------------------------------
# Admin Web (separate service; not NestJS)
# Set in admin-web/.env.local (dev) or admin-web/.env.production / Vercel.
# --------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://yelo-laundry-apps-production-2e03.up.railway.app/api/v1

# --------------------------------------------------
# Mobile apps (compile-time dart-define, not NestJS)
# --------------------------------------------------
# flutter run --dart-define-from-file=config/api/emulator.json
# ./scripts/flutter-run-mobile.sh physical staff
# ./scripts/flutter-build-mobile-apk.sh production staff
