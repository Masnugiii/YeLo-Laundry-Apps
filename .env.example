# ==================================================
# DATABASE
# ==================================================

DATABASE_URL=

# ==================================================
# APPLICATION
# ==================================================

APP_NAME=Yelo Laundry ERP
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
BODY_LIMIT=10mb

# ==================================================
# JWT
# ==================================================

JWT_SECRET=
JWT_EXPIRES_IN=7d

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# ==================================================
# OTP
# ==================================================

OTP_LENGTH=6
OTP_EXPIRED_MINUTES=5

# Comma-separated phones allowed for Admin Web dev OTP testing (local only).
# DEV_OTP_PHONE_WHITELIST=081234567890,081234567891,081910090910

# ==================================================
# REDIS
# ==================================================

REDIS_HOST=localhost
REDIS_PORT=6379

# ==================================================
# STORAGE
# ==================================================

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# ==================================================
# PAYMENT GATEWAY (production — configure before go-live)
# ==================================================
# No payment webhook is implemented yet; wallet top-up uses manual confirm.
# Add provider credentials when gateway integration is completed.

# PAYMENT_PROVIDER=
# PAYMENT_MERCHANT_ID=
# PAYMENT_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_CALLBACK_URL=
# PAYMENT_RETURN_URL=

# ==================================================
# ADMIN WEB (build-time — set in admin-web/.env.local or CI)
# ==================================================
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Production: NEXT_PUBLIC_API_BASE_URL=<PRODUCTION_API_URL>

# ==================================================
# MOBILE APPS (Staff ERP + Customer App)
# ==================================================
# Prefer --dart-define-from-file with config/api/*.json
# Do NOT ship production APKs with LAN IP / localhost / 10.0.2.2.
#
# Android emulator:
#   flutter run --dart-define-from-file=config/api/emulator.json
#   # → http://10.0.2.2:3000/api/v1
#
# Physical Android (auto-detects Mac LAN IP):
#   ./scripts/flutter-run-mobile.sh physical staff
#   ./scripts/build-yelo-internal-release-apk.sh
#   # → http://<Mac-LAN-IP>:3000/api/v1  (this Mac: 192.168.110.53)
#
# Production (HTTPS domain only):
#   cp config/api/production.json.example config/api/production.json
#   # set API_BASE_URL=https://<your-production-host>/api/v1
#   ./scripts/flutter-build-mobile-apk.sh production staff
#
# NestJS must listen on LAN for physical devices:
#   APP_HOST=0.0.0.0
#   APP_PORT=3000
#
# Helper scripts:
#   ./scripts/run-yelo-internal-emulator.sh
#   ./scripts/run-yelo-internal-physical-preview.sh
#   ./scripts/build-yelo-internal-release-apk.sh
#   ./scripts/flutter-run-mobile.sh emulator staff
#   ./scripts/flutter-run-mobile.sh physical staff
#   ./scripts/flutter-build-mobile-apk.sh physical staff
#   ./scripts/flutter-build-mobile-apk.sh production staff

# APP_ENV=production
# CORS_ORIGINS=https://admin.yourdomain.com
# JWT_SECRET=<strong-random-secret>
# REFRESH_TOKEN_SECRET=<strong-random-secret>
# DATABASE_URL=<production-postgres-url>
# ==================================================
# WHATSAPP / OTP DELIVERY (production — required for customer OTP)
# ==================================================

WHATSAPP_API_KEY=
WHATSAPP_BASE_URL=

